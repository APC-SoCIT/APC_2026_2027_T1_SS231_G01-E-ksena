# Use the same TURN credentials as the web dashboard. Separate multiple URLs
# with commas and include TCP/443 for mobile networks that block TURN over UDP.
EXPO_PUBLIC_TURN_URL=turn:your-app.relay.metered.ca:80,turn:your-app.relay.metered.ca:443?transport=tcp,turns:your-app.relay.metered.ca:443?transport=tcp
EXPO_PUBLIC_TURN_USERNAME=your-turn-username
EXPO_PUBLIC_TURN_CREDENTIAL=your-turn-credential
