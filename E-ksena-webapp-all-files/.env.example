# Copy this file to .env and fill in the real values.
# .env is gitignored -- never commit it.
#
# Every variable here is prefixed EXPO_PUBLIC_, which means Expo inlines it
# into the browser bundle at build time. These values are visible to anyone who
# opens the site, so they must only ever be publishable/restricted keys:
#   - Supabase: the anon/publishable key, never the service_role key.
#   - Google Maps: a key locked down in Google Cloud Console (API restrictions,
#     plus HTTP referrer restrictions once the site has a real domain).
# Real secrets must never be placed in an EXPO_PUBLIC_ variable.

# Supabase project URL, e.g. https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key (Dashboard > Project Settings > API)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps key with Maps JavaScript API, Directions API and Geocoding API
# enabled (Google Cloud Console > APIs & Services > Credentials)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
